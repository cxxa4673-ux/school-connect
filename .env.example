# Environment Configuration & Secret Safe Template
# ==============================================================================
# WARNING: NEVER commit actual secrets, private tokens, or credentials here.
# AI Studio automatically injects required environment variables at runtime.
# ==============================================================================

# 1. Gemini AI API Key (Server-Side Secret - NEVER expose to browser)
GEMINI_API_KEY=

# 2. Host Application URL
APP_URL=http://localhost:3000

# 3. Environment & Port Configuration
NODE_ENV=development
PORT=3000
