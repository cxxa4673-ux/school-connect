# ==============================================================================
# School-Connect Environment Configuration
# COPY this file to `.env` and fill in your values.
# ==============================================================================
# WARNING: NEVER commit your real `.env` file. It is git-ignored.
# ==============================================================================

# ---------------------------------------------------------------------------
# 1. Gemini AI (server-side secret - NEVER expose to the browser)
# ---------------------------------------------------------------------------
# Set this to make every AI feature (chat, weakness analysis, revision plan,
# progress report, question explainer) work with real personalized responses.
GEMINI_API_KEY=

# Which Gemini model to use (defaults to an inexpensive fast model).
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# 2. Supabase (REAL backend: auth + database)
# ---------------------------------------------------------------------------
# Fill these to switch the app from demo/localStorage mode to a real backend:
#   - Auth: real email + password accounts
#   - Data: profiles/tests/questions/attempts/etc. persist across devices
# The anon key is safe for the browser. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 3. Host Application URL
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 4. Environment & Port
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
